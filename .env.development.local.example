# Backend-only development configuration. Copy to .env.development.local.
# Use a local MySQL instance, and URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://spanish:YOUR_PASSWORD@127.0.0.1:3306/spanish?charset=utf8mb4
APP_ORIGIN=http://localhost:3000
# Extra allowed browser origins, comma-separated; add your LAN address as needed.
APP_ORIGINS=http://127.0.0.1:3000
COOKIE_SECURE=false
SPEECH_URL=http://127.0.0.1:8001
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_admin_password
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Optional: absolute cover storage directory; default is backend/uploads.
# UPLOAD_DIR=/absolute/path/to/cover-uploads
