# Use URL-safe random passwords (hex is recommended).
MYSQL_PASSWORD=replace_with_random_hex_password
MYSQL_ROOT_PASSWORD=replace_with_different_random_hex_password
APP_ORIGIN=http://localhost:3000
# Local HTTP only. Production must use HTTPS and true.
COOKIE_SECURE=false

# Only this account may reset all practice data; empty disables the action.
RESET_ADMIN_EMAIL=

# Native macOS MLX worker, reached from Docker Desktop.
SPEECH_URL=http://host.docker.internal:8001
