# Use URL-safe random passwords (hex is recommended).
MYSQL_PASSWORD=replace_with_random_hex_password
MYSQL_ROOT_PASSWORD=replace_with_different_random_hex_password
APP_ORIGIN=http://localhost:3000
# Extra allowed browser origins, comma-separated; add your LAN address as needed.
APP_ORIGINS=http://127.0.0.1:3000
# Local HTTP only. Production must use HTTPS and true.
COOKIE_SECURE=false

# Created automatically on API startup; email is the login account name.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_admin_password


# Native macOS MLX worker, reached from Docker Desktop.
SPEECH_URL=http://host.docker.internal:8001
